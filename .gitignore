target/

# Eclipse
.classpath
.project
.settings/
.metadata/
RemoteSystemsTempFiles/

# Maschinenspezifischer TLS-Truststore (aus dem Windows-Zertifikatspeicher exportiert)
certs/

# Claude Code – projektweite Konventionen/Skills GEHÖREN ins Repo (mit dem Team geteilt).
# Nur die maschinenlokalen persönlichen Einstellungen bleiben außen vor.
.claude/settings.local.json

# Lokale statische Vorschau (kein Bestandteil des Projekts)
preview/

# Vaadin / Frontend (in beliebigen Modulen, daher mit **/ ; deckt auch src/main/frontend/generated ab)
node_modules/
**/frontend/generated/
package-lock.json
pnpm-lock.yaml
vite.config.ts
vite.generated.ts
tsconfig.json
types.d.ts
# Auto-generierter Vaadin-Einstiegspunkt – erst versionieren, wenn er bewusst angepasst wird
**/src/main/frontend/index.html
# Generierte npm-Konfiguration (cafile-Pfad ist maschinenspezifisch, siehe demo-app/build.gradle)
.npmrc

# Vaadin Frontend-Development-Bundle (2+ MB Binaerdatei) samt auto-generierter Begleit-README:
# bei jedem Frontend-Build neu erzeugt, nicht mergebar. Wird bei Bedarf lokal regeneriert.
**/src/main/bundles/

# Betriebssystem
Thumbs.db
.DS_Store

# Knowledge Base (graphify): graph.json/GRAPH_REPORT.md/graph.html werden versioniert (Team-Wissen),
# aber Zustands-/Cache-Dateien sind maschinenlokal (absolute Pfade, mtimes) und bleiben draußen.
graphify-out/.graphify_*
graphify-out/cache/
graphify-out/manifest.json
graphify-out/needs_update
graphify-out/cost.json
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
